<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Memoria.Web.Samples</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Memoria\Memoria.csproj" />
        <ProjectReference Include="..\Memoria.EventSourcing\Memoria.EventSourcing.csproj" />
        <ProjectReference Include="..\Memoria.EventSourcing.Store.EntityFrameworkCore\Memoria.EventSourcing.Store.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\Memoria.EventSourcing.Store.Cosmos\Memoria.EventSourcing.Store.Cosmos.csproj" />
        <ProjectReference Include="..\Memoria.EventSourcing.Dcb\Memoria.EventSourcing.Dcb.csproj" />
        <ProjectReference Include="..\Memoria.EventSourcing.Dcb.Store.EntityFrameworkCore\Memoria.EventSourcing.Dcb.Store.EntityFrameworkCore.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.9" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
        <!-- Pinned ahead of the provider's transitive version, which carries GHSA-2m69-gcr7-jv3q. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.7" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- The tool's own provider resolution, so the seeder writes to whichever store the tool
             reads rather than assuming Postgres. Linked rather than referenced: this assembly is
             uploaded to the tool as an extension, and a project reference would carry the whole
             web application in with it. -->
        <Compile Include="..\Memoria.Web\Data\DatabaseProvider.cs" Link="Data\DatabaseProvider.cs" />
        <Compile Include="..\Memoria.Web\Data\DatabaseConnection.cs" Link="Data\DatabaseConnection.cs" />
        <Compile Include="..\Memoria.Web\Data\CosmosStore.cs" Link="Data\CosmosStore.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
