@page "/dcb/aggregates"
@using Memoria.Web.Extensibility
@inject DomainTypeRegistry Types

<PageTitle>DCB @Heading</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="">Home</a>
    <span aria-hidden="true">/</span>
    <a href="dcb">DCB</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Aggregates</span>
</nav>

<h1>@Heading</h1>
<p class="lede">
    The DCB write models, and what has been stored of them.
</p>

@* The two ways into the section, one row each rather than a pair of links on one: this page is
   the parent of both, so each gets the same room to say what is there. *@
<ul class="sections">
    <li>
        <a href="dcb/aggregates/types">
            <span class="name">Types</span>
            <span class="detail">
                @Count(Catalogue.DcbAggregates.Count, "aggregate") the model declares, addressed by
                @Count(Catalogue.DcbAggregateIds.Count, "identifier").
            </span>
        </a>
    </li>
    <li>
        <a href="dcb/aggregates/data">
            <span class="name">Data</span>
            <span class="detail">The aggregates that have been stored, read one identifier at a time.</span>
        </a>
    </li>
</ul>

@if (Catalogue.DcbAggregates.Count == 0)
{
    <p class="lede">
        No DCB aggregates are registered. Upload a zip of assemblies on the
        <a href="settings">settings</a> page.
    </p>
}

@code {

    /// <summary>
    /// What the page is, for the heading and the title. One value for both, so they cannot drift
    /// apart; the tab puts the section in front of it, because a tab is read away from the
    /// breadcrumb that says which section this is.
    /// </summary>
    private const string Heading = "Aggregates";

    private DomainTypeCatalogue Catalogue => Types.Current;

    private static string Count(int count, string noun) =>
        count == 1 ? $"1 {noun}" : $"{count} {noun}s";

}
