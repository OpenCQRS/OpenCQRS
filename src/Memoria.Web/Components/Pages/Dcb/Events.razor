@page "/dcb/events"
@using Memoria.Web.Extensibility
@inject DomainTypeRegistry Types

<PageTitle>DCB events</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="">Home</a>
    <span aria-hidden="true">/</span>
    <a href="dcb">DCB</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Events</span>
</nav>

<h1>Events</h1>

@if (EventTypes.Count == 0)
{
    <p class="lede">
        No DCB model applies any event. Upload a zip of assemblies on the
        <a href="settings">settings</a> page.
    </p>
}
else
{
    <div class="panels">
        <nav class="panel panel-index" aria-label="Events">
            <ul>
                @foreach (var @event in EventTypes)
                {
                    @* A plain row, with nothing folded under it. The models fold their identifiers
                       there because an identifier addresses one of them; nothing addresses an event,
                       and what an event is carried by is not yet something these pages can say. *@
                    <li class="@CurrentClass(@event)">
                        @NameRow(@event)
                    </li>
                }
            </ul>
        </nav>

        <section class="panel panel-detail">
            @* Selected is only null when the list is empty, which the branch above already covers. *@
            @if (Selected is not null)
            {
                @* The same name the row in the list carries, so the heading answers the click that
                   reached it — and the version is part of it, because two versions of one name are
                   two rows there. The class it is bound from is the first fact on the info tab. *@
                <h2>@BoundAs(Selected)</h2>

                @* Two views, switched by the address rather than by script: each tab is a link, so a
                   view can be linked to and gone back to, and the page stays statically rendered
                   like the rest of them. What the type is, then what it carries. Where an event is
                   appended, and what folds it, is a third view this page does not have yet. *@
                <nav class="tabs" aria-label="Event views">
                    <a id="tab-@InfoTab" href="@TabLink(InfoTab)"
                       aria-current="@(Tab == InfoTab ? "page" : null)">Info</a>
                    <a id="tab-@StateTab" href="@TabLink(StateTab)"
                       aria-current="@(Tab == StateTab ? "page" : null)">State</a>
                </nav>

                @* Each panel is named by the tab that reaches it, so the label is written once
                   rather than repeated as a heading under the row that already says it. *@
                @if (Tab == StateTab)
                {
                    <section class="tab-panel" aria-labelledby="tab-@StateTab">
                        <p class="lede">
                            The properties the event declares — what it carries into every fold that
                            applies it. A property holding a value of the domain's own is unfolded
                            in rows under the one that holds it.
                        </p>

                        @if (Properties.Count == 0)
                        {
                            <p class="missing">It carries nothing of its own.</p>
                        }
                        else
                        {
                            @* The same two columns the models list their shape in, so an event's
                               payload and the state it lands in are read the same way. *@
                            <table class="grid">
                                <thead>
                                <tr>
                                    <th scope="col">Property</th>
                                    <th scope="col">Type</th>
                                </tr>
                                </thead>
                                <tbody>
                                @StateRows((Properties, 0))
                                </tbody>
                            </table>
                        }
                    </section>
                }
                else
                {
                    <section class="tab-panel" aria-labelledby="tab-@InfoTab">
                        <dl class="facts">
                            @* The two halves of what the log writes it under, apart: the name
                               outlives a rename of the class, and the version is what a change to
                               the shape stored under that name is answered with. An event carrying
                               no [EventType] is written by nothing and read back by nothing. *@
                            <dt>Name</dt>
                            <dd>
                                @if (Binding is { } named)
                                {
                                    <code>@named.Name</code>
                                }
                                else
                                {
                                    <span class="missing">not bound — it carries no [EventType]</span>
                                }
                            </dd>

                            @if (Binding is { } versioned)
                            {
                                <dt>Version</dt>
                                <dd>@versioned.Version</dd>
                            }

                            <dt>Class</dt>
                            <dd><code>@Selected.FullName</code></dd>

                            <dt>Assembly</dt>
                            <dd>@(Selected.Assembly.GetName().Name ?? "unknown")</dd>
                        </dl>
                    </section>
                }
            }
        </section>
    </div>
}

@code {

    [SupplyParameterFromQuery(Name = "type")]
    private string? SelectedName { get; set; }

    /// <summary>
    /// The two views the panel offers, named as they appear in the address. Which one is showing is
    /// the address's to say, so a view can be linked to, bookmarked, and gone back to.
    /// </summary>
    private const string InfoTab = "info";

    private const string StateTab = "state";

    [SupplyParameterFromQuery(Name = "tab")]
    private string? RequestedTab { get; set; }

    /// <summary>
    /// Matched against the two the page has, so an unknown name in the address opens the one it
    /// opens with rather than an empty panel.
    /// </summary>
    private string Tab =>
        string.Equals(RequestedTab, StateTab, StringComparison.OrdinalIgnoreCase) ? StateTab : InfoTab;

    /// <summary>
    /// The events some DCB aggregate or projection applies, rather than every event found.
    /// </summary>
    /// <remarks>
    /// An event is the same event whichever model appends it, and the framework binds them all in
    /// one map for that reason — but a page under DCB is read as the DCB model's own, and an event
    /// nothing here folds would be a row leading nowhere. Which model applies which is read off
    /// their filters once, when the assemblies are.
    /// </remarks>
    private IReadOnlyList<Type> EventTypes => Types.Current.DcbEvents;

    /// <summary>
    /// The event being shown: the one asked for, or the first in the list. Arriving with nothing
    /// chosen shows the first rather than an empty panel, because there is nothing to decide before
    /// something can be read.
    /// </summary>
    private Type? Selected =>
        DomainTypeDescriber.Select(EventTypes, SelectedName) ?? EventTypes.FirstOrDefault();

    /// <summary>
    /// What the selected event is bound as, read straight off the type.
    /// </summary>
    /// <remarks>
    /// Read in pieces rather than through <c>Describe</c>, which the model pages use: describing
    /// constructs the type to read the event filter of a model, and an event is not one — it has no
    /// filter, nothing addresses it, and constructing it would be work done to answer nothing.
    /// </remarks>
    private DomainTypeBinding? Binding => Selected is null ? null : DomainTypeDescriber.BindingOf(Selected);

    private IReadOnlyList<DomainProperty> Properties =>
        Selected is null ? [] : DomainTypeDescriber.PropertiesOf(Selected);

    /// <summary>
    /// What an event is written into the log as, falling back to the class when it carries no
    /// attribute — an unbound type is still worth listing, and the panel beside the list says it is
    /// unbound.
    /// </summary>
    private static string BoundAs(Type @event) =>
        DomainTypeDescriber.BindingOf(@event) is { } binding
            ? $"{binding.Name} v{binding.Version}"
            : @event.Name;

    /// <summary>
    /// Another event, read the same way as the one being left: the tab travels with the choice, so
    /// a facet compared across two types is one click each rather than two.
    /// </summary>
    private string Link(Type @event) =>
        $"dcb/events?type={Uri.EscapeDataString(@event.FullName ?? @event.Name)}&tab={Tab}";

    /// <summary>
    /// A tab of the event already chosen.
    /// </summary>
    private string TabLink(string tab) =>
        $"dcb/events?type={Uri.EscapeDataString(Selected?.FullName ?? string.Empty)}&tab={tab}";

    private bool IsCurrent(Type @event) => @event == Selected;

    private string? CurrentClass(Type @event) => IsCurrent(@event) ? "current" : null;

    private string? CurrentFlag(Type @event) => IsCurrent(@event) ? "true" : null;

    /// <summary>
    /// The row that names one event and selects it. A link rather than a click handler: the page
    /// renders statically like the rest, and the choice stays in the address so it can be shared.
    /// </summary>
    private RenderFragment<Type> NameRow => @event =>
        @<a class="index-row" href="@Link(@event)" aria-current="@CurrentFlag(@event)">
            @* Named by what it is bound as rather than by the class: that is the name written into
               the log and the one a stored event is read back under, and it is the name that stays
               put when the class is renamed. The namespace it came from is on the info tab, with
               the rest of what is true of the class rather than of the binding. *@
            <span class="index-name">@BoundAs(@event)</span>
        </a>;

    /// <summary>
    /// The properties a type declares, a row each, with the properties of any value one holds in
    /// rows under it.
    /// </summary>
    /// <remarks>
    /// Draws itself and carries how deep it has got, because the depth is what the indent is made
    /// of. How far there is to go is the describer's to decide, not this.
    /// </remarks>
    private RenderFragment<(IReadOnlyList<DomainProperty> Properties, int Depth)> StateRows => rows =>
        @<text>
            @foreach (var property in rows.Properties)
            {
                <tr class="@Under(rows.Depth)">
                    <td>@property.Name</td>
                    <td><code>@property.TypeName</code></td>
                </tr>

                @if (property.Children.Count > 0)
                {
                    @StateRows((property.Children, rows.Depth + 1))
                }
            }
        </text>;

    /// <summary>
    /// How far under something a row sits, as a class rather than a measurement, so how wide a step
    /// is stays the stylesheet's to say.
    /// </summary>
    /// <remarks>
    /// A row at the top is not under anything and carries no class at all. Past the third step the
    /// class stops changing: the describer stops unfolding before then, and a table that keeps
    /// stepping in stops being a table.
    /// </remarks>
    private static string? Under(int depth) => depth == 0 ? null : $"under-{Math.Min(depth, 3)}";

}
