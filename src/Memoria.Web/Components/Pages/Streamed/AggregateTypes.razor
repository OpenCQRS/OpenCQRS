@page "/streamed/aggregates/types"
@using Memoria.Web.Extensibility
@inject DomainTypeRegistry Types

<PageTitle>Streamed @Heading</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="">Home</a>
    <span aria-hidden="true">/</span>
    <a href="streamed">Streamed</a>
    <span aria-hidden="true">/</span>
    <a href="streamed/aggregates">Aggregates</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Types</span>
</nav>

<h1>@Heading</h1>

@if (Aggregates.Count == 0)
{
    <p class="lede">
        No streamed aggregates are registered. Upload a zip of assemblies on the
        <a href="settings">settings</a> page.
    </p>
}
else
{
    <div class="panels">
        <nav class="panel panel-index" aria-label="Aggregates">
            @* What the card holds, in the voice the tables cap their columns in — the card beside
               this one is capped by the name of what is being read, and this one by what there is
               to read. It is also the only place on the page the count appears: the section page
               says how many there are before a reader comes here, and nothing said it after. *@
            <p class="index-cap">@Counted(Aggregates.Count, "aggregate")</p>

            <ul>
                @foreach (var aggregate in Aggregates)
                {
                    @* The whole group is marked as the current one, not just its first row, so an
                       open row and the identifiers under it read as one selected block. *@
                    <li class="@CurrentClass(aggregate)">
                        @* The identifiers it can be loaded by, folded under the row that names it:
                           the same links the identifiers tab lists, reached without first choosing
                           the aggregate and then the tab. A <details> rather than script, like the
                           header menu, because these pages render statically — and open for the
                           aggregate being read, so choosing one is what opens it while any other
                           can still be peeked into without leaving the one on the right. *@
                        @if (Identifiers(aggregate) is { Count: > 0 } identifiers)
                        {
                            <details open="@IsCurrent(aggregate)">
                                @* The name is a link inside the summary rather than the summary
                                   itself: a click on it selects the aggregate, and a click beside
                                   it only opens the row. *@
                                <summary>@NameRow(aggregate)</summary>

                                <ul class="index-links">
                                    @foreach (var identifier in identifiers)
                                    {
                                        <li>
                                            @* The mark the Data tile on the section page is entered
                                               through, in front of the name rather than opposite
                                               it: here the whole row is the one link, and the mark
                                               says what kind of place it leads to rather than which
                                               row. The identifiers tab keeps the mark in a column
                                               of its own, because there it is the link and one per
                                               row. *@
                                            <a href="@DataLink(aggregate, identifier)">
                                                <SectionMark Kind="SectionKind.Data"/>
                                                @identifier.Name
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </details>
                        }
                        else
                        {
                            @* Nothing addresses it, so there is nothing to disclose and no caret
                               offering to. The row is the plain link it looks like. *@
                            @NameRow(aggregate)
                        }
                    </li>
                }
            </ul>
        </nav>

        <section class="panel panel-detail">
            @* Selected is only null when the list is empty, which the branch above already covers. *@
            @if (Selected is { } selected)
            {
                @* The same name the row in the list carries, so the heading answers the click that
                   reached it — and the version is part of it, because two versions of one name are
                   two rows there. The class it is bound from is the first fact on the info tab. *@
                <h2>@BoundAs(selected.Type)</h2>
                <ObsoleteNote Type="selected.Type"/>

                @* The four views of it, drawn by the component the detail page opens over a stored
                   row as well: what is true of a declared type is the same wherever it is read, and
                   there is one place it is written. *@
                <TypeView Description="selected"
                          Kind="ModelKind.Aggregate"
                          Store="ModelStore.Streamed"
                          Tab="@Tab"
                          TabLink="TabLink"
                          DataLink="@(identifier => DataLink(selected.Type, identifier))"/>
            }
        </section>
    </div>
}

@code {

    /// <summary>
    /// What the page is, for the heading and the title. One value for both, so they cannot drift
    /// apart; the tab puts the section and the group in front of it, because a tab is read away
    /// from the breadcrumb that says which of them this page sits under.
    /// </summary>
    private const string Heading = "Aggregate Types";

    [SupplyParameterFromQuery(Name = "type")]
    private string? SelectedName { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    private string? RequestedTab { get; set; }

    /// <summary>
    /// Which view is open, matched against the four there are so an unknown name in the address
    /// opens the one a type opens with rather than an empty panel.
    /// </summary>
    private string Tab => TypeView.Match(RequestedTab);

    private IReadOnlyList<Type> Aggregates => Types.Current.StreamedAggregates;

    /// <summary>
    /// The aggregate being shown: the one asked for, or the first in the list. Arriving with nothing
    /// chosen shows the first rather than an empty panel, because there is nothing to decide before
    /// something can be read.
    /// </summary>
    private DomainTypeDescription? Selected =>
        (DomainTypeDescriber.Select(Aggregates, SelectedName) ?? Aggregates.FirstOrDefault()) is { } type
            ? DomainTypeDescriber.Describe(type, Types.Current.StreamedAggregateIds)
            : null;

    /// <summary>
    /// What an aggregate is stored under, falling back to the class when it carries no attribute —
    /// an unbound type is still worth listing, and the panel beside the list says it is unbound.
    /// </summary>
    /// <remarks>
    /// Written as the name and a version after it rather than as the store's own key: the key joins
    /// the two with a colon because something has to read them back apart, which is the store's
    /// need and not the reader's. Here they are a name and its version, said the way a version is
    /// said. The key itself is on the info tab, in the two halves it is made of.
    /// </remarks>
    private static string BoundAs(Type aggregate) => DomainTypeDescriber.LabelOf(aggregate);

    /// <summary>
    /// The identifiers that address one aggregate. Read off the type on its own rather than out of
    /// a full description: the list has every aggregate in it, and describing each one constructs
    /// it to read its event filter, which nothing on a row shows.
    /// </summary>
    private IReadOnlyList<Type> Identifiers(Type aggregate) =>
        DomainTypeDescriber.IdentifiersOf(aggregate, Types.Current.StreamedAggregateIds);

    /// <summary>
    /// Through to what has been stored of one of these. The aggregate travels with the identifier
    /// because an identifier alone does not say what it addresses — and it is passed in rather than
    /// taken from the selection, because the list links rows that are not selected.
    /// </summary>
    private static string DataLink(Type aggregate, Type identifier) =>
        "streamed/aggregates/data" +
        $"?type={Uri.EscapeDataString(aggregate.FullName ?? string.Empty)}" +
        $"&id={Uri.EscapeDataString(identifier.FullName ?? string.Empty)}";

    /// <summary>
    /// A tab of the aggregate already chosen.
    /// </summary>
    private string TabLink(string tab) =>
        $"streamed/aggregates/types?type={Uri.EscapeDataString(Selected?.Type.FullName ?? string.Empty)}&tab={tab}";

    /// <summary>
    /// Another aggregate, read the same way as the one being left: the tab travels with the choice,
    /// so a facet compared across two types is one click each rather than two.
    /// </summary>
    private string Link(Type aggregate) =>
        $"streamed/aggregates/types?type={Uri.EscapeDataString(aggregate.FullName ?? aggregate.Name)}&tab={Tab}";

    private bool IsCurrent(Type aggregate) => aggregate == Selected?.Type;

    private string? CurrentClass(Type aggregate) => IsCurrent(aggregate) ? "current" : null;

    private string? CurrentFlag(Type aggregate) => IsCurrent(aggregate) ? "true" : null;

    /// <summary>
    /// The row that names one aggregate and selects it. A link rather than a click handler: the
    /// page renders statically like the rest, and the choice stays in the address so it can be
    /// shared. Written once because it is the same row whether or not identifiers fold under it.
    /// </summary>
    private RenderFragment<Type> NameRow => aggregate =>
        @<a class="index-row" href="@Link(aggregate)" aria-current="@CurrentFlag(aggregate)">
            @* Named by what it is bound as rather than by the class: that is the name the store
               writes and the one a stored row is found under, and it is the name that stays put
               when the class is renamed. The namespace it came from is on the info tab, with the
               rest of what is true of the class rather than of the binding. *@
            <span class="index-name">@BoundAs(aggregate)<ObsoleteMark Type="aggregate"/></span>
        </a>;

    /// <summary>
    /// How many of something, written so one of it is not one of them.
    /// </summary>
    private static string Counted(int count, string noun) =>
        count == 1 ? $"1 {noun}" : $"{count} {noun}s";

}
