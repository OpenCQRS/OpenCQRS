@page "/streamed/events"

<PageTitle>Streamed @Heading</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="">Home</a>
    <span aria-hidden="true">/</span>
    <a href="streamed">Streamed</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Events</span>
</nav>

<h1>@Heading</h1>
<p class="lede">
    The events the streamed model can apply, and what has been stored of them.
</p>

<SectionTiles TypesHref="streamed/events/types" DataHref="streamed/events/data">
    <TypesDetail>The events the model declares, and the state each one carries.</TypesDetail>
    <DataDetail>The events that have been appended, read one type at a time.</DataDetail>
</SectionTiles>

@code {

    /// <summary>
    /// What the page is, for the heading and the title. One value for both, so they cannot drift
    /// apart; the tab puts the section in front of it, because a tab is read away from the
    /// breadcrumb that says which section this is.
    /// </summary>
    private const string Heading = "Events";

}
