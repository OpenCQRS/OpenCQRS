@page "/streamed/projections/data"
@using Memoria.Web.Data
@using Memoria.Web.Extensibility
@using Microsoft.AspNetCore.WebUtilities
@inject DomainTypeRegistry Types
@inject StreamedStoreDbContext StoreContext
@inject NavigationManager Navigation

<PageTitle>Streamed projection data</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="">Home</a>
    <span aria-hidden="true">/</span>
    <a href="streamed">Streamed</a>
    <span aria-hidden="true">/</span>
    <a href="streamed/projections">Projections</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Data</span>
</nav>

<h1>@Heading</h1>

@if (Choice.Unknown)
{
    <p class="alert" role="alert">
        That projection is not among the registered types. It may have been replaced by a later
        upload — start again from <a href="streamed/projections/types">projections</a>.
    </p>
}
else if (Stream.Unknown)
{
    <p class="alert" role="alert">
        That stream is not among the registered types. It may have been replaced by a later upload —
        start again from <a href="streamed/streams">streams</a>.
    </p>
}
else
{
    @* Above the table, because it says what the table holds. Its own GET form, like the pickers
       under the table: the narrowing is a link to a narrower list, so it belongs in the address bar
       where it can be bookmarked, shared and gone back to. The order travels in hidden fields so
       narrowing does not silently reorder; the page deliberately does not, because page four of one
       stream is not page four of another.

       The dropdowns submit on change and the box is typed into, so the button is not only the
       fallback when scripting is off — it submits all three at once, which is what one form buys. *@
    <form class="search" method="get" action="streamed/projections/data">
        @* The stream comes first, as it does in the table: it is where the events a projection reads
           were appended, and the type is what was folded from them. *@
        <label for="stream">Stream</label>
        <select id="stream" name="stream" onchange="this.form.submit()">
            @* First and default, so a reader who has chosen nothing is looking at everything stored
               rather than at whichever stream happened to be listed first. An empty value, which is
               what the address carries when nothing is narrowed to. *@
            <option value="" selected="@Stream.IsAll">All</option>
            @foreach (var streamId in StreamTypes)
            {
                @* Named by the type, not by the pattern it matches: a reader picks the kind of
                   stream they mean, and customer:% is how the store is asked rather than a thing to
                   choose. *@
                <option value="@streamId.FullName" selected="@(streamId == Stream.Stream)">
                    @BoundAs(streamId)
                </option>
            }
        </select>

        <label for="type">Projection</label>
        <select id="type" name="type" onchange="this.form.submit()">
            <option value="" selected="@Choice.IsAll">All</option>
            @foreach (var projection in ProjectionTypes)
            {
                <option value="@projection.FullName" selected="@(projection == Choice.Event)">
                    @BoundAs(projection)
                </option>
            }
        </select>

        @* Beside the two rather than under them, because all three narrow the same list: a stream
           type is the kind of stream a row was folded out of, a projection type is what it was
           folded into, and this is what the row itself says — its stream, its id and its state, any
           of which matching is enough. *@
        <label class="visually-hidden" for="text">Filter by stream, id or state</label>
        <input id="text" type="search" name="text" value="@Text"
               placeholder="Filter by stream, id or state" autocomplete="off"/>
        <input type="hidden" name="sort" value="@Sort.ToString().ToLowerInvariant()"/>
        <input type="hidden" name="dir" value="@(Descending ? "desc" : "asc")"/>
        <input type="hidden" name="size" value="@PageSize"/>
        @if (StatesAsked is not null)
        {
            <input type="hidden" name="states" value="@Token(StatesOpen)"/>
        }
        <button type="submit" class="quiet">Filter</button>
        @if (!Choice.IsAll || !Stream.IsAll || IsFiltered)
        {
            @* One way back to everything stored, because that is the one thing a reader wants from
               here: dropping one narrowing and keeping the other two would leave them still to
               undo. *@
            <a href="@Link(Sort, Descending, 1, clearStream: true, clearType: true, clearText: true)">Clear</a>
        }
    </form>

    @if (Choice.Unbound)
    {
        @* Registered, listed, and impossible to have been stored: without a [ProjectionType] there
           is no key to write a snapshot under. An empty table would say the store holds none of
           these, which is true but not the reason. *@
        <p class="missing">
            It carries no <code>[ProjectionType]</code>, so the store has never written one of these.
        </p>
    }
    else if (Stream.Unshaped)
    {
        @* Registered, listed, and impossible to narrow by. A stream is found by the shape of the ids
           it writes, and that shape is worked out by building one from values that can be recognised
           again — which this stream takes none of. *@
        <p class="missing">
            Its ids cannot be recognised, so the store cannot be narrowed to it: it is named from a
            value nothing can stand in for.
        </p>
    }
    else if (Projections.Error is not null)
    {
        <p class="alert" role="alert">@Projections.Error</p>
    }
    else if (Projections.Total == 0)
    {
        <p class="empty">
            @* Nothing found and nothing there are two different answers, and what was asked for is
               the difference: an empty store has none of these to match, and a store that holds
               plenty of them has none carrying this, or none of them in this stream. *@
            @if (IsFiltered)
            {
                <text>No stream, id or state matches &ldquo;@Text&rdquo;.</text>
            }
            else if (Choice.IsAll && Stream.IsAll)
            {
                <text>Nothing has been written yet.</text>
            }
            else if (Choice.IsAll)
            {
                <text>Nothing has been written from this stream yet.</text>
            }
            else if (Stream.IsAll)
            {
                <text>Nothing of this type has been written yet.</text>
            }
            else
            {
                <text>Nothing of this type has been written from this stream yet.</text>
            }
        </p>
    }
    else
    {
        @* The lede and the fold, at the two ends of the line above the table, in the same shape as
           the pager and the rows-per-page picker at the two ends of the line below it. *@
        <div class="table-header">
            @* The whole count, not this page's worth: the pager says which page, and what a reader
               wants beside it is how much there is to page through. *@
            <p class="lede">@Summary</p>

            @* Opens or closes every state on the page at once. A link rather than a control with
               script behind it, like the order and the page beside it: the state lives in the
               address, so a page opened out can be linked to and gone back to, and the rows stay
               foldable one at a time either way. *@
            <a class="fold-all" href="@Link(Sort, Descending, Projections.Page, open: !StatesOpen)">
                @(StatesOpen ? "Collapse all" : "Expand all")
                <span class="arrow @(StatesOpen ? "up" : "down")" aria-hidden="true"></span>
            </a>
        </div>

        @* The stream first, as on the events page, because it is where the row came from. Then what
           the row is — its id and its type — then what the store says about the fold: the version it
           reached, the sequence it had read up to, and when it was written. The state it holds is
           last, because it is the column with something to open.

           The version and the sequence are two different counts and both are the store's own. The
           version is how many events this model had folded; the sequence is how far along its stream
           that took it. They differ whenever the stream holds events this model does not apply. *@
        <table class="grid snapshots">
            <thead>
            <tr>
                <th scope="col" class="col-stream">Stream</th>
                <th scope="col" class="col-id">Id</th>
                <th scope="col" class="col-type">Type</th>
                <th scope="col" class="col-version">Version</th>
                <th scope="col" class="col-sequence">Sequence</th>
                @foreach (var column in Columns)
                {
                    <th scope="col" class="col-date" aria-sort="@AriaSort(column.Sort)">
                        <a href="@SortLink(column.Sort)">
                            @column.Label
                            @if (Sort == column.Sort)
                            {
                                <span class="arrow @(Descending ? "down" : "up")" aria-hidden="true"></span>
                            }
                        </a>
                    </th>
                }
                <th scope="col" class="col-state">State</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var stored in Projections.Snapshots)
            {
                <tr>
                    <td><code>@stored.StreamId</code></td>
                    <td><code>@stored.Id</code></td>
                    <td><code>@stored.Name</code></td>
                    <td class="numeric">@stored.Version</td>
                    <td class="numeric">@stored.Sequence</td>
                    <td>@stored.Created.ToLocalTime().ToString("g")</td>
                    <td>@stored.Updated.ToLocalTime().ToString("g")</td>
                    <td>
                        @if (stored.Error is not null)
                        {
                            <span class="missing">@stored.Error</span>
                        }
                        else if (stored.State.Count == 0)
                        {
                            <span class="missing">It holds nothing of its own.</span>
                        }
                        else
                        {
                            @* Folded away, and closed to begin with: the state is the only cell tall
                               enough to push the row about the projection off its own line, and a
                               page of snapshots is read by running down the ids and the types
                               first. A <details> rather than script, like the rows on the events
                               page, because these pages render statically. *@
                            <details class="payload" open="@StatesOpen">
                                @* How much is under it, so a closed row still says whether opening
                                   it is worth it. What it holds is the pairs' to say. *@
                                <summary>@Held(stored.State.Count)</summary>

                                @* A list, because that is what it is: one name and value per item.
                                   The name is set apart from the value it names, so a cell of
                                   several pairs is scanned rather than read through — and a value
                                   with a shape inside it is opened under its own name. *@
                                @Pairs(stored.State)
                            </details>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <div class="table-footer">
            <div class="pagination">
                @if (Projections.TotalPages > 1)
                {
                    @if (Projections.Page > 1)
                    {
                        <a href="@Link(Sort, Descending, 1)">First</a>
                        <a href="@Link(Sort, Descending, Projections.Page - 1)">Previous</a>
                    }
                    else
                    {
                        <span class="disabled">First</span>
                        <span class="disabled">Previous</span>
                    }

                    @* The page number is a control rather than a label, so a long table can be
                       crossed without stepping through it. Its own GET form, like the order and the
                       rows per page, so the page it lands on is in the address bar. *@
                    <form class="page-jump" method="get" action="streamed/projections/data">
                        <label for="page">Page</label>
                        <select id="page" name="page" onchange="this.form.submit()">
                            @for (var number = 1; number <= Projections.TotalPages; number++)
                            {
                                <option value="@number" selected="@(number == Projections.Page)">@number</option>
                            }
                        </select>
                        <span>of @Projections.TotalPages</span>
                        @Narrowing
                        <input type="hidden" name="sort" value="@Sort.ToString().ToLowerInvariant()"/>
                        <input type="hidden" name="dir" value="@(Descending ? "desc" : "asc")"/>
                        <input type="hidden" name="size" value="@PageSize"/>
                        <noscript>
                            <button type="submit">Go</button>
                        </noscript>
                    </form>

                    @if (Projections.Page < Projections.TotalPages)
                    {
                        <a href="@Link(Sort, Descending, Projections.Page + 1)">Next</a>
                        <a href="@Link(Sort, Descending, Projections.TotalPages)">Last</a>
                    }
                    else
                    {
                        <span class="disabled">Next</span>
                        <span class="disabled">Last</span>
                    }
                }
            </div>

            @* Its own GET form, so the choice lands in the address bar like the order and the
               filter. Submitting on change saves a click; the button is the fallback when scripting
               is off. No page travels with it: a page number from a narrower page size would land
               somewhere a reader did not ask for, and the first page is what they can see they are
               getting. *@
            <form class="page-size" method="get" action="streamed/projections/data">
                <label for="size">Rows per page</label>
                <select id="size" name="size" onchange="this.form.submit()">
                    @foreach (var option in InstanceQuery.PageSizes)
                    {
                        <option value="@option" selected="@(option == PageSize)">@option</option>
                    }
                </select>
                @Narrowing
                <input type="hidden" name="sort" value="@Sort.ToString().ToLowerInvariant()"/>
                <input type="hidden" name="dir" value="@(Descending ? "desc" : "asc")"/>
                <noscript>
                    <button type="submit">Apply</button>
                </noscript>
            </form>
        </div>
    }
}

@code {

    /// <summary>
    /// Which projections are being looked at: all of them, one type, or neither because the name in
    /// the address reaches nothing that could have been written.
    /// </summary>
    /// <remarks>
    /// <see cref="EventChoice"/> is named for the page it was written for, but what it does is read
    /// a type's binding key off whichever of the three attributes it carries — so it answers for a
    /// projection exactly as it does for an event, and the key it hands over is the one the store
    /// wrote the snapshot under.
    /// </remarks>
    private EventChoice Choice { get; set; } = new(Event: null, Unknown: false);

    /// <summary>
    /// Which kind of stream they were folded out of, or all of them.
    /// </summary>
    private StreamChoice Stream { get; set; } = new(Stream: null, Unknown: false);

    /// <summary>
    /// The stream types the uploaded assemblies declare, which is what the first dropdown offers and
    /// what a name in the address is matched against.
    /// </summary>
    private IReadOnlyList<Type> StreamTypes => Types.Current.StreamedStreamIds;

    /// <summary>
    /// Which of the two streamed models this page lists, which is what tells the reader shared with
    /// the aggregates page which of the store's two snapshot tables holds this page's rows.
    /// </summary>
    private const StreamedModelKind Kind = StreamedModelKind.Projection;

    /// <summary>The projections they declare, which is what the second offers.</summary>
    private IReadOnlyList<Type> ProjectionTypes => Types.Current.Streamed(Kind);

    private StoredStreamSnapshots Projections { get; set; } =
        new([], Total: 0, Page: 1, TotalPages: 1, Error: null);

    private InstanceSort Sort { get; set; } = InstanceSort.Updated;

    private bool Descending { get; set; } = true;

    private int PageSize { get; set; } = InstanceQuery.DefaultPageSize;

    /// <summary>
    /// The text a row has to carry, in its stream id, its own id or its stored state, or null when
    /// the store is read whole.
    /// </summary>
    private string? Text { get; set; }

    private bool IsFiltered => !string.IsNullOrWhiteSpace(Text);

    /// <summary>
    /// The two dates a snapshot has and the order they are offered in: when it was first written,
    /// then when it last was. Kept in one place so the header row and the links cannot disagree
    /// about what can be sorted.
    /// </summary>
    private static readonly Column[] Columns =
    [
        new(InstanceSort.Created, "Created"),
        new(InstanceSort.Updated, "Updated")
    ];

    private sealed record Column(InstanceSort Sort, string Label);

    private string? AriaSort(InstanceSort column) =>
        Sort != column ? null : Descending ? "descending" : "ascending";

    /// <summary>
    /// Clicking the column already sorted by turns it around; clicking the other starts it newest
    /// first, which is the way a date is usually wanted.
    /// </summary>
    private string SortLink(InstanceSort column) =>
        Link(column, Sort != column || !Descending, 1);

    /// <summary>
    /// What the address says about the states, when it says anything, and null when it does not.
    /// </summary>
    private bool? StatesAsked { get; set; }

    /// <summary>
    /// Whether every state on the page starts open. Closed unless the address says otherwise: a page
    /// of snapshots is read by running down the ids and the types, and the states are what is opened
    /// once something on a row is worth following.
    /// </summary>
    /// <remarks>
    /// Filtering turns the default over, because the text a row matched on may be inside the fold: a
    /// filtered page that opened closed would be a search whose results are hidden. A row that
    /// matched on its stream or its id shows that in its own column either way, and opening it costs
    /// nothing.
    /// </remarks>
    private bool StatesOpen => StatesAsked ?? IsFiltered;

    /// <summary>What the address says when the states are out, and when they are folded away.</summary>
    private const string Open = "open";

    private const string Closed = "closed";

    private static string Token(bool open) => open ? Open : Closed;

    /// <summary>
    /// How much a folded state has under it, so a closed row still says whether opening it is worth
    /// it. The properties it declares, not the ones nested inside them: the count belongs to what
    /// the fold hides at its first line.
    /// </summary>
    private static string Held(int values) => values == 1 ? "1 value" : $"{values} values";

    /// <summary>
    /// What the page is, for the heading.
    /// </summary>
    /// <remarks>
    /// The page rather than the choices, and the same however far the list is narrowed. The
    /// dropdowns above the table say what is being looked at and the line under them says how much
    /// of it there is; a heading that changed with them would be a third voice saying the same
    /// thing.
    /// </remarks>
    private const string Heading = "Projections Data";

    /// <summary>
    /// What a type is stored as, falling back to the class when it carries no attribute — the same
    /// name the types pages list it under, so one row means one thing across them.
    /// </summary>
    private static string BoundAs(Type type) => DomainTypeDescriber.LabelOf(type);

    /// <summary>How far the list is narrowed to one projection, in the words the count is counted in.</summary>
    private string Of => Choice.IsAll ? string.Empty : $", of {Choice.Name}";

    /// <summary>And to one kind of stream, said after it: what was folded, then where from.</summary>
    private string In => Stream.IsAll ? string.Empty : $", in {Stream.Name}";

    /// <summary>
    /// How much there is, and of what.
    /// </summary>
    /// <remarks>
    /// A filtered count counts what matched, which is not the same claim as how much is stored. Said
    /// the way the events page says it, so a count means one thing across the two.
    /// </remarks>
    private string Summary => (Projections.Total, IsFiltered) switch
    {
        (1, false) => $"One projection stored{Of}{In}.",
        (_, false) => $"{Projections.Total} projections stored{Of}{In}.",
        (1, true) => $"One matching projection{Of}{In}.",
        (_, true) => $"{Projections.Total} matching projections{Of}{In}."
    };

    /// <summary>
    /// One address for the whole table state, so a link only changes what it means to change.
    /// </summary>
    /// <param name="sort">Which date to order by.</param>
    /// <param name="descending">Whether the newest come first.</param>
    /// <param name="page">The page to land on, from one.</param>
    /// <param name="clearStream">Whether to widen back to every stream.</param>
    /// <param name="clearType">Whether to widen back to every projection.</param>
    /// <param name="clearText">Whether to drop the text a row had to carry.</param>
    /// <param name="open">Whether the states are out, or null to carry on as they are.</param>
    private string Link(
        InstanceSort sort,
        bool descending,
        int page,
        bool clearStream = false,
        bool clearType = false,
        bool clearText = false,
        bool? open = null)
    {
        var link = $"streamed/projections/data?sort={sort.ToString().ToLowerInvariant()}" +
                   $"&dir={(descending ? "desc" : "asc")}" +
                   $"&size={PageSize}" +
                   $"&page={page}";

        if ((open ?? StatesAsked) is { } folded)
        {
            link += $"&states={Token(folded)}";
        }

        if (!clearStream && Stream.Stream is { } stream)
        {
            link += $"&stream={Uri.EscapeDataString(stream.FullName ?? stream.Name)}";
        }

        if (!clearType && Choice.Event is { } chosen)
        {
            link += $"&type={Uri.EscapeDataString(chosen.FullName ?? chosen.Name)}";
        }

        return clearText || !IsFiltered
            ? link
            : $"{link}&text={Uri.EscapeDataString(Text!)}";
    }

    /// <summary>
    /// The narrowing, as the hidden fields a form has to carry to keep it. A form replaces the whole
    /// query, so what is being looked at travels with it or paging would quietly widen the table.
    /// </summary>
    private RenderFragment Narrowing => @<text>
        @if (Stream.Stream is { } stream)
        {
            <input type="hidden" name="stream" value="@stream.FullName"/>
        }
        @if (Choice.Event is { } chosen)
        {
            <input type="hidden" name="type" value="@chosen.FullName"/>
        }
        @if (IsFiltered)
        {
            <input type="hidden" name="text" value="@Text"/>
        }
        @if (StatesAsked is not null)
        {
            <input type="hidden" name="states" value="@Token(StatesOpen)"/>
        }
    </text>;

    protected override async Task OnParametersSetAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);

        string? Value(string name) =>
            query.TryGetValue(name, out var found) ? found.LastOrDefault() : null;

        Stream = StreamChoice.Of(StreamTypes, Value("stream"));
        Choice = EventChoice.Of(ProjectionTypes, Value("type"));
        Text = Value("text");
        Sort = InstanceQuery.SortOf(Value("sort"));
        Descending = !string.Equals(Value("dir"), "asc", StringComparison.OrdinalIgnoreCase);
        PageSize = InstanceQuery.PageSizeOf(Value("size"));

        // Anything else it might say is not an answer, and null is the one state that lets the
        // filter decide — which is what an address that says nothing usable should fall back to.
        StatesAsked = Value("states") switch
        {
            { } said when string.Equals(said, Open, StringComparison.OrdinalIgnoreCase) => true,
            { } said when string.Equals(said, Closed, StringComparison.OrdinalIgnoreCase) => false,
            _ => null
        };

        // A choice with nothing to look for is not asked about. A null key and a null pattern narrow
        // to everything rather than to nothing, so asking would answer the name of one projection, or
        // of one stream, with the whole store.
        if (Choice.ShowsNothing || Stream.ShowsNothing)
        {
            Projections = new StoredStreamSnapshots([], Total: 0, Page: 1, TotalPages: 1, Error: null);

            return;
        }

        Projections = await StreamedSnapshots.Page(
            StoreContext,
            Kind,
            Stream.Pattern,
            Choice.Key,
            Text,
            Sort,
            Descending,
            int.TryParse(Value("page"), out var asked) ? asked : 1,
            PageSize);
    }

    /// <summary>
    /// The properties of one snapshot, a name and a value each, with the properties of any value one
    /// holds nested under it.
    /// </summary>
    /// <remarks>
    /// Draws itself, because a snapshot nests as deep as the describer read it. Inside a cell rather
    /// than as rows: the whole state is one column of a row about the projection, so there are no
    /// columns of its own to keep anything lined up with.
    /// </remarks>
    private RenderFragment<IReadOnlyList<DomainPropertyValue>> Pairs => properties =>
        @<ul class="pairs">
            @foreach (var property in properties)
            {
                <li>
                    <span class="pair-name">@property.Name</span>

                    @if (property.Children.Count == 0)
                    {
                        <span class="pair-value">@(property.Value ?? "—")</span>
                    }
                    else
                    {
                        @* How many there are, when it is a list. A single shape says nothing here
                           that the pairs under it do not say better. *@
                        @if (property.Value is not null)
                        {
                            <span class="pair-value">@property.Value</span>
                        }

                        @Pairs(property.Children)
                    }
                </li>
            }
        </ul>;

}
